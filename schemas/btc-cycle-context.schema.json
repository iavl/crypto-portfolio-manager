{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/btc-cycle-context.schema.json",
  "title": "BTC halving and cycle context",
  "type": "object",
  "required": ["as_of", "halving_context", "market_cycle_state", "cycle_risk", "confidence", "evidence_ids", "reasons"],
  "properties": {
    "as_of": {"type": "string", "format": "date-time"},
    "last_halving_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "days_since_halving": {"type": ["integer", "null"], "minimum": 0},
    "estimated_next_halving_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "estimated_days_to_next_halving": {"type": ["integer", "null"], "minimum": 0},
    "halving_epoch_progress": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "return_since_halving": {"type": ["number", "null"], "minimum": -1},
    "distance_from_ath": {"type": ["number", "null"]},
    "drawdown": {"type": ["number", "null"], "maximum": 0},
    "mvrv": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "mvrv_zscore": {"type": ["number", "null"]},
    "realized_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "market_to_realized_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "sopr": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "lth_supply_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "lth_net_position_change": {"type": ["number", "null"]},
    "sth_realized_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "lth_realized_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "nupl": {"type": ["number", "null"]},
    "halving_context": {"enum": ["PRE_HALVING", "EARLY_POST_HALVING", "MID_EPOCH", "LATE_EPOCH", "UNKNOWN"]},
    "valuation_state": {"enum": ["NORMAL", "ELEVATED", "EXTREME", "UNKNOWN"]},
    "holder_state": {"enum": ["ACCUMULATION", "NEUTRAL", "DISTRIBUTION", "UNKNOWN"]},
    "market_cycle_state": {"enum": ["RESET", "EXPANSION", "MATURE", "OVERHEATED", "CONTRACTION", "UNKNOWN"]},
    "cycle_risk": {"enum": ["LOW", "NORMAL", "ELEVATED", "HIGH", "UNKNOWN"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "positioning_state": {"type": ["string", "null"]},
    "positioning_risk": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_metadata": {"type": "object"},
    "data_quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
