{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/market.schema.json",
  "title": "Normalized Crypto Market Observations",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/spotPrice"},
    {"$ref": "#/$defs/ohlcvSeries"}
  ],
  "$defs": {
    "spotPrice": {
      "type": "object",
      "required": ["symbol", "price", "observed_at", "source"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "observed_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1},
        "fetched_at": {"type": ["string", "null"], "format": "date-time"},
        "venue": {"type": ["string", "null"]},
        "market": {"type": ["string", "null"]},
        "quote_currency": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "candle": {
      "type": "object",
      "required": ["timestamp", "open", "high", "low", "close", "volume"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "open": {"type": "number", "exclusiveMinimum": 0},
        "high": {"type": "number", "exclusiveMinimum": 0},
        "low": {"type": "number", "exclusiveMinimum": 0},
        "close": {"type": "number", "exclusiveMinimum": 0},
        "volume": {"type": "number", "minimum": 0},
        "completed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ohlcvSeries": {
      "type": "object",
      "required": ["symbol", "timeframe", "candles", "source"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "timeframe": {"enum": ["1H", "4H", "1D"]},
        "candles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candle"}},
        "source": {"type": "string", "minLength": 1},
        "fetched_at": {"type": ["string", "null"], "format": "date-time"},
        "venue": {"type": ["string", "null"]},
        "market": {"type": ["string", "null"]},
        "quote_currency": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
