{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/evidence.schema.json",
  "title": "Portfolio Evidence",
  "type": "object",
  "required": [
    "id",
    "asset",
    "factor",
    "source",
    "observed_at",
    "fetched_at",
    "freshness",
    "confidence"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "asset": {"type": "string", "minLength": 1},
    "factor": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "freshness": {"type": "string", "enum": ["CURRENT", "STALE", "UNKNOWN"]},
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
    "value": {},
    "summary": {"type": ["string", "null"]},
    "metadata": {"type": ["object", "null"]},
    "source_group": {"type": ["string", "null"], "minLength": 1},
    "authority_tier": {"type": ["integer", "null"], "enum": [1, 2, 3, null]},
    "source_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confidence_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "conflict_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
