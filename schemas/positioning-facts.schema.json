{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/positioning-facts.schema.json",
  "title": "Derivatives positioning facts",
  "type": "object",
  "required": ["symbol", "as_of", "leverage_state", "bias", "risk", "social_state", "confidence", "evidence_ids", "notes"],
  "properties": {
    "symbol": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "funding_rate": {"type": ["number", "null"]},
    "funding_rate_24h_avg": {"type": ["number", "null"]},
    "funding_rate_7d_avg": {"type": ["number", "null"]},
    "funding_rate_percentile": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "open_interest_usd": {"type": ["number", "null"], "minimum": 0},
    "open_interest_change_1d": {"type": ["number", "null"]},
    "open_interest_change_7d": {"type": ["number", "null"]},
    "open_interest_to_market_cap": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "long_short_account_ratio": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "top_trader_long_short_ratio": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "long_liquidations_24h_usd": {"type": ["number", "null"], "minimum": 0},
    "short_liquidations_24h_usd": {"type": ["number", "null"], "minimum": 0},
    "total_liquidations_24h_usd": {"type": ["number", "null"], "minimum": 0},
    "long_liquidations_7d_usd": {"type": ["number", "null"], "minimum": 0},
    "short_liquidations_7d_usd": {"type": ["number", "null"], "minimum": 0},
    "futures_basis_annualized": {"type": ["number", "null"]},
    "social_bullish_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "social_mentions_24h": {"type": ["number", "null"], "minimum": 0},
    "social_mentions_change_7d": {"type": ["number", "null"]},
    "social_sentiment_percentile": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "social_attention_percentile": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "market_fear_greed": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "leverage_state": {"enum": ["DELEVERAGED", "NORMAL", "BUILDING", "CROWDED", "EXTREME", "UNKNOWN"]},
    "bias": {"enum": ["SHORT_CROWDED", "SHORT_BIASED", "BALANCED", "LONG_BIASED", "LONG_CROWDED", "UNKNOWN"]},
    "risk": {"enum": ["LOW", "NORMAL", "ELEVATED", "HIGH", "EXTREME", "UNKNOWN"]},
    "social_state": {"enum": ["FEARFUL", "NEUTRAL", "OPTIMISTIC", "EUPHORIC", "UNKNOWN"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_metadata": {"type": "object"},
    "data_quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
