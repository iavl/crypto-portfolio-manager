{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/portfolio-normalized.schema.json",
  "title": "Normalized Crypto Portfolio Snapshot",
  "type": "object",
  "required": ["config", "policy_version", "timestamp", "base_currency", "total_value_usd", "reported_total_value_usd", "visible_positions_value_usd", "visible_value_coverage_ratio", "stablecoin_weight", "core_weight", "satellite_weight", "portfolio_drawdown", "external_cash_flow", "cost_known_current_value_usd", "cost_known_cost_basis_usd", "total_unrealized_pnl_known_usd", "aggregate_unrealized_return_pct", "pnl_value_coverage_ratio", "position_performance", "positions", "warnings"],
  "properties": {
    "config": {"type": "object"},
    "policy_version": {"type": "integer", "minimum": 1},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "source": {"type": ["string", "null"]},
    "base_currency": {"type": "string", "minLength": 1},
    "total_value_usd": {"type": "number", "exclusiveMinimum": 0},
    "reported_total_value_usd": {"type": ["number", "null"], "minimum": 0},
    "visible_positions_value_usd": {"type": "number", "minimum": 0},
    "visible_value_coverage_ratio": {"type": ["number", "null"], "minimum": 0},
    "stablecoin_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "core_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "satellite_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "portfolio_drawdown": {"type": ["number", "null"], "minimum": -1, "maximum": 0},
    "external_cash_flow": {"type": "number"},
    "external_cash_flow_type": {"enum": ["NONE", "DEPOSIT", "WITHDRAWAL", "UNRESOLVED"]},
    "cost_known_current_value_usd": {"type": "number", "minimum": 0},
    "cost_known_cost_basis_usd": {"type": "number", "minimum": 0},
    "total_unrealized_pnl_known_usd": {"type": ["number", "null"]},
    "aggregate_unrealized_return_pct": {"type": ["number", "null"]},
    "pnl_value_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "position_performance": {"type": "object"},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "quantity", "value_usd", "cost_basis_usd", "asset_type", "computed_weight"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "quantity": {"type": ["number", "null"], "minimum": 0},
          "value_usd": {"type": "number", "minimum": 0},
          "current_price_usd": {"type": ["number", "null"], "minimum": 0},
          "average_cost_price_usd": {"type": ["number", "null"], "minimum": 0},
          "exchange_unrealized_pnl_usd": {"type": ["number", "null"]},
          "cost_basis_usd": {"type": ["number", "null"], "minimum": 0},
          "unrealized_pnl_usd": {"type": ["number", "null"]},
          "unrealized_return_pct": {"type": ["number", "null"]},
          "pnl_status": {
            "type": "string",
            "enum": ["AVAILABLE", "COST_UNKNOWN", "ZERO_COST", "INSUFFICIENT_DATA", "CROSSCHECK_WARNING", "MATERIAL_MISMATCH"]
          },
          "validation_status": {
            "type": "string",
            "enum": ["PASS", "ROUNDING_WARNING", "MATERIAL_MISMATCH", "INSUFFICIENT_DATA"]
          },
          "validation_notes": {"type": "array", "items": {"type": "string"}},
          "computed_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "displayed_current_price_usd": {"type": ["number", "null"], "minimum": 0},
          "displayed_average_cost_price_usd": {"type": ["number", "null"], "minimum": 0},
          "performance": {"type": "object"},
          "asset_type": {"type": "string", "enum": ["core", "satellite", "stablecoin", "cash", "other"]},
          "asset_type_hint": {"type": "string", "enum": ["core", "satellite", "stablecoin", "cash", "other"]}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
