{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/portfolio-normalized.schema.json",
  "title": "Normalized Crypto Portfolio Snapshot",
  "type": "object",
  "required": ["config", "timestamp", "base_currency", "total_value_usd", "reported_total_value_usd", "visible_positions_value_usd", "visible_value_coverage_ratio", "stablecoin_weight", "core_weight", "satellite_weight", "portfolio_drawdown", "external_cash_flow", "external_cash_flow_type", "cash_flow_resolution_status", "cost_known_current_value_usd", "cost_known_cost_basis_usd", "total_unrealized_pnl_known_usd", "aggregate_unrealized_return", "pnl_value_coverage_ratio", "position_performance", "positions", "warnings"],
  "properties": {
    "config": {"type": "object"},
    "timestamp": {"type": "string", "format": "date-time"},
    "snapshot_id": {"type": ["string", "null"], "minLength": 1},
    "source": {"type": ["string", "null"]},
    "base_currency": {"type": "string", "minLength": 1},
    "total_value_usd": {"type": "number", "exclusiveMinimum": 0},
    "reported_total_value_usd": {"type": ["number", "null"], "minimum": 0},
    "visible_positions_value_usd": {"type": "number", "minimum": 0},
    "visible_value_coverage_ratio": {"type": ["number", "null"], "minimum": 0},
    "stablecoin_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "core_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "satellite_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "portfolio_drawdown": {"type": ["number", "null"], "minimum": -1, "maximum": 0},
    "external_cash_flow": {"type": ["number", "null"]},
    "external_cash_flow_type": {"type": ["string", "null"], "enum": ["NONE", "DEPOSIT", "WITHDRAWAL", null]},
    "cash_flow_resolution_status": {"enum": ["CONFIRMED_NONE", "CONFIRMED_AMOUNT", "UNRESOLVED", "BASELINE_RESET"]},
    "cost_known_current_value_usd": {"type": "number", "minimum": 0},
    "cost_known_cost_basis_usd": {"type": "number", "minimum": 0},
    "total_unrealized_pnl_known_usd": {"type": ["number", "null"]},
    "aggregate_unrealized_return": {"type": ["number", "null"]},
    "pnl_value_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "position_performance": {"type": "object"},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "quantity", "value_usd", "cost_basis_usd", "asset_type", "portfolio_weight"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "quantity": {"type": ["number", "null"], "minimum": 0},
          "value_usd": {"type": "number", "minimum": 0},
          "current_price_usd": {"type": ["number", "null"], "minimum": 0},
          "average_cost_price_usd": {"type": ["number", "null"], "minimum": 0},
          "exchange_unrealized_pnl_usd": {"type": ["number", "null"]},
          "cost_basis_usd": {"type": ["number", "null"], "minimum": 0},
          "unrealized_pnl_usd": {"type": ["number", "null"]},
          "unrealized_return": {"type": ["number", "null"]},
          "pnl_status": {
            "type": "string",
            "enum": ["AVAILABLE", "COST_UNKNOWN", "ZERO_COST", "INSUFFICIENT_DATA", "CROSSCHECK_WARNING", "MATERIAL_MISMATCH"]
          },
          "validation_status": {
            "type": "string",
            "enum": ["PASS", "ROUNDING_WARNING", "MATERIAL_MISMATCH", "INSUFFICIENT_DATA"]
          },
          "validation_notes": {"type": "array", "items": {"type": "string"}},
          "portfolio_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "displayed_current_price_usd": {"type": ["number", "null"], "minimum": 0},
          "displayed_average_cost_price_usd": {"type": ["number", "null"], "minimum": 0},
          "performance": {"type": "object"},
          "management_status": {"const": "EXCLUDED / UNMANAGED"},
          "asset_type": {"type": "string", "enum": ["core", "satellite", "stablecoin", "cash", "other"]},
          "asset_type_hint": {"type": "string", "enum": ["core", "satellite", "stablecoin", "cash", "other"]}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"cash_flow_resolution_status": {"enum": ["CONFIRMED_NONE", "BASELINE_RESET"]}}}, "then": {"properties": {"external_cash_flow": {"const": 0}, "external_cash_flow_type": {"const": "NONE"}}}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "BASELINE_RESET"}}}, "then": {"required": ["snapshot_id"]}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "CONFIRMED_AMOUNT"}}}, "then": {"properties": {"external_cash_flow": {"type": "number", "not": {"const": 0}}, "external_cash_flow_type": {"enum": ["DEPOSIT", "WITHDRAWAL"]}}}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "UNRESOLVED"}}}, "then": {"properties": {"external_cash_flow": {"type": "null"}, "external_cash_flow_type": {"type": "null"}}}}
    ,{"if": {"properties": {"cash_flow_resolution_status": {"const": "CONFIRMED_AMOUNT"}, "external_cash_flow_type": {"const": "DEPOSIT"}}}, "then": {"properties": {"external_cash_flow": {"exclusiveMinimum": 0}}}}
    ,{"if": {"properties": {"cash_flow_resolution_status": {"const": "CONFIRMED_AMOUNT"}, "external_cash_flow_type": {"const": "WITHDRAWAL"}}}, "then": {"properties": {"external_cash_flow": {"exclusiveMaximum": 0}}}}
  ],
  "additionalProperties": false
}
