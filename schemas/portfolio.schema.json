{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/portfolio.schema.json",
  "title": "Crypto Portfolio Input (compatibility contract)",
  "type": "object",
  "required": ["timestamp", "base_currency", "positions"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {"type": ["string", "null"]},
    "base_currency": {"type": "string"},
    "policy_version": {"type": "integer", "minimum": 1},
    "external_cash_flow": {"type": "number"},
    "total_value": {"type": ["number", "null"], "minimum": 0},
    "reported_total_value": {"type": ["number", "null"], "minimum": 0},
    "portfolio_peak_value": {"type": ["number", "null"], "minimum": 0},
    "config": {
      "type": "object",
      "properties": {
        "core_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "description": "Resolved from config/policy.json unless explicitly overridden."
        },
        "satellite_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "description": "Resolved from config/policy.json unless explicitly overridden."
        },
        "stable_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "description": "Resolved from config/policy.json unless explicitly overridden."
        },
        "min_stablecoin_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Resolved from config/policy.json unless explicitly overridden."
        },
        "max_portfolio_drawdown": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Resolved from config/policy.json unless explicitly overridden."
        }
      },
      "additionalProperties": false
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "value_usd"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "quantity": {"type": ["number", "null"], "minimum": 0},
          "value_usd": {"type": "number", "minimum": 0},
          "current_price_usd": {"type": ["number", "null"], "minimum": 0},
          "average_cost_price_usd": {"type": ["number", "null"], "minimum": 0},
          "exchange_unrealized_pnl_usd": {"type": ["number", "null"]},
          "displayed_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "cost_basis_usd": {"type": ["number", "null"], "minimum": 0},
          "asset_type_hint": {
            "type": ["string", "null"],
            "enum": ["core", "satellite", "stablecoin", "cash", "other", null]
          },
          "asset_type": {
            "description": "Legacy input alias treated as a validated classification hint.",
            "type": "string",
            "enum": ["core", "satellite", "stablecoin", "cash", "other"]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
