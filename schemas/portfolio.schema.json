{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/portfolio.schema.json",
  "title": "Crypto Portfolio Snapshot",
  "type": "object",
  "required": ["timestamp", "base_currency", "positions"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {"type": ["string", "null"]},
    "base_currency": {"type": "string", "default": "USD"},
    "reported_total_value": {"type": ["number", "null"], "minimum": 0},
    "portfolio_peak_value": {"type": ["number", "null"], "minimum": 0},
    "config": {
      "type": "object",
      "properties": {
        "core_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": ["BTC", "ETH"]
        },
        "satellite_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": ["SOL", "BNB", "LINK", "AAVE"]
        },
        "stable_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": ["USDT", "USDC", "DAI", "FDUSD", "TUSD", "USD", "CASH"]
        },
        "min_stablecoin_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        },
        "max_portfolio_drawdown": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.2
        }
      },
      "additionalProperties": false
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "value_usd"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "quantity": {"type": ["number", "null"], "minimum": 0},
          "value_usd": {"type": "number", "minimum": 0},
          "displayed_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "cost_basis_usd": {"type": ["number", "null"], "minimum": 0},
          "asset_type": {
            "type": "string",
            "enum": ["core", "satellite", "stablecoin", "cash", "other"]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
