{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/cash-flow-resolution.schema.json",
  "title": "Confirmed historical cash-flow resolution",
  "type": "object",
  "required": ["resolution_id", "snapshot_id", "timestamp", "cash_flow_type", "amount", "rationale"],
  "properties": {
    "resolution_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "cash_flow_type": {"enum": ["DEPOSIT", "WITHDRAWAL", "NONE"]},
    "amount": {"type": "number"},
    "rationale": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"cash_flow_type": {"const": "NONE"}}, "required": ["cash_flow_type"]},
      "then": {"properties": {"amount": {"const": 0}}}
    },
    {
      "if": {"properties": {"cash_flow_type": {"const": "DEPOSIT"}}, "required": ["cash_flow_type"]},
      "then": {"properties": {"amount": {"exclusiveMinimum": 0}}}
    },
    {
      "if": {"properties": {"cash_flow_type": {"const": "WITHDRAWAL"}}, "required": ["cash_flow_type"]},
      "then": {"properties": {"amount": {"exclusiveMaximum": 0}}}
    }
  ],
  "additionalProperties": false
}
