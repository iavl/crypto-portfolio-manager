{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/portfolio-input.schema.json",
  "title": "Crypto Portfolio Input",
  "type": "object",
  "required": ["timestamp", "base_currency", "positions"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {"type": ["string", "null"]},
    "base_currency": {"type": "string", "minLength": 1},
    "external_cash_flow": {"type": ["number", "null"]},
    "external_cash_flow_type": {"type": ["string", "null"], "enum": ["NONE", "DEPOSIT", "WITHDRAWAL", null]},
    "cash_flow_resolution_status": {"enum": ["CONFIRMED_NONE", "CONFIRMED_AMOUNT", "UNRESOLVED", "BASELINE_RESET"]},
    "snapshot_id": {"type": ["string", "null"], "minLength": 1},
    "total_value": {"type": ["number", "null"], "minimum": 0},
    "config": {
      "type": "object",
      "properties": {
        "core_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "satellite_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "stable_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "excluded_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "min_stablecoin_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "max_portfolio_drawdown": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "value_usd"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "quantity": {"type": ["number", "null"], "minimum": 0},
          "value_usd": {"type": "number", "minimum": 0},
          "current_price_usd": {"type": ["number", "null"], "minimum": 0},
          "average_cost_price_usd": {"type": ["number", "null"], "minimum": 0},
          "exchange_unrealized_pnl_usd": {"type": ["number", "null"]},
          "displayed_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "cost_basis_usd": {"type": ["number", "null"], "minimum": 0},
          "asset_type_hint": {"type": ["string", "null"], "enum": ["core", "satellite", "stablecoin", "cash", "other", null]},
          "asset_type": {"type": "string", "enum": ["core", "satellite", "stablecoin", "cash", "other"]}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"cash_flow_resolution_status": {"enum": ["CONFIRMED_NONE", "BASELINE_RESET"]}}, "required": ["cash_flow_resolution_status"]}, "then": {"required": ["external_cash_flow", "external_cash_flow_type"], "properties": {"external_cash_flow": {"const": 0}, "external_cash_flow_type": {"const": "NONE"}}}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "BASELINE_RESET"}}, "required": ["cash_flow_resolution_status"]}, "then": {"required": ["snapshot_id"]}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "CONFIRMED_AMOUNT"}}, "required": ["cash_flow_resolution_status"]}, "then": {"required": ["external_cash_flow", "external_cash_flow_type"], "properties": {"external_cash_flow": {"type": "number", "not": {"const": 0}}, "external_cash_flow_type": {"enum": ["DEPOSIT", "WITHDRAWAL"]}}}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "UNRESOLVED"}}, "required": ["cash_flow_resolution_status"]}, "then": {"properties": {"external_cash_flow": {"type": "null"}, "external_cash_flow_type": {"type": "null"}}}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "CONFIRMED_AMOUNT"}, "external_cash_flow_type": {"const": "DEPOSIT"}}, "required": ["cash_flow_resolution_status", "external_cash_flow_type"]}, "then": {"properties": {"external_cash_flow": {"exclusiveMinimum": 0}}}},
    {"if": {"properties": {"cash_flow_resolution_status": {"const": "CONFIRMED_AMOUNT"}, "external_cash_flow_type": {"const": "WITHDRAWAL"}}, "required": ["cash_flow_resolution_status", "external_cash_flow_type"]}, "then": {"properties": {"external_cash_flow": {"exclusiveMaximum": 0}}}},
    {"if": {"not": {"required": ["cash_flow_resolution_status"]}}, "then": {"properties": {"external_cash_flow": {"type": "null"}, "external_cash_flow_type": {"type": "null"}}}}
  ],
  "additionalProperties": false
}
