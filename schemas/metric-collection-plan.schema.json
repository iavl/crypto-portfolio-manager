{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/metric-collection-plan.schema.json",
  "title": "Deterministic metric collection plan",
  "type": "object",
  "required": ["review_type", "assets", "requests", "critical_metric_keys", "discovery_required_assets", "excluded_assets", "collector_model"],
  "properties": {
    "review_type": {"enum": ["SNAPSHOT_REVIEW", "FULL_REVIEW", "EVENT_REVIEW"]},
    "assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "collector_model": {"const": "LUNA_MAX"},
    "critical_metric_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "discovery_required_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "metric_key", "factor", "value_type", "unit", "critical", "freshness", "trend_enabled", "can_reuse", "cached_observation_id", "reason", "history_requirement", "fallback_mode"],
        "properties": {
          "asset": {"type": "string", "minLength": 1},
          "metric_key": {"type": "string", "minLength": 1},
          "factor": {"type": "string", "minLength": 1},
          "value_type": {"enum": ["number", "string"]},
          "unit": {"type": ["string", "null"]},
          "decision_role": {"enum": ["SCORING_FACTOR", "EVENT_RISK", "POSITIONING_OVERLAY", "CYCLE_CONTEXT", "EXECUTION_CONTEXT", "STRUCTURAL_RISK"]},
          "context_group": {"type": ["string", "null"]},
          "fallback_mode": {"enum": ["STRUCTURED_ONLY", "WEB_ALLOWED"]},
          "critical": {"type": "boolean"},
          "freshness": {"type": ["string", "number"]},
          "trend_enabled": {"type": "boolean"},
          "can_reuse": {"type": "boolean"},
          "cached_observation_id": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "history_requirement": {
            "type": "object",
            "required": ["mode", "days", "tolerance_days"],
            "properties": {
              "mode": {"enum": ["CURRENT", "BOUNDED", "FULL_AVAILABLE"]},
              "days": {"type": ["integer", "null"], "minimum": 1},
              "tolerance_days": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
