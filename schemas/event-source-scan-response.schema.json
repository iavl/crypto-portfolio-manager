{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/event-source-scan-response.schema.json",
  "title": "Structured event source scan response",
  "type": "object",
  "required": ["source_id", "reachable", "checked_at", "items", "error", "conflict", "complete_for_source"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "reachable": {"type": "boolean"},
    "checked_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "external_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "format": "date-time"},
          "canonical_url": {"type": "string", "format": "uri"},
          "summary": {"type": "string", "minLength": 1},
          "materiality": {"oneOf": [{"type": "boolean"}, {"type": "string"}]},
          "is_material": {"type": ["boolean", "null"]},
          "affected_assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "severity": {"enum": ["CLEAR", "WATCH", "ELEVATED", "CRITICAL"]},
          "impact_direction": {"enum": ["POSITIVE", "NEGATIVE", "MIXED", "NEUTRAL", "UNCERTAIN"]},
          "magnitude": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "implementation_status": {"enum": ["DISCUSSION", "PROPOSED", "VOTING", "PASSED", "EXECUTED", "REJECTED", "UNKNOWN"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "relevance": {"oneOf": [{"enum": ["RELEVANT", "IRRELEVANT", "UNKNOWN"]}, {"type": "object"}]},
          "relevance_metadata": {"type": "object"},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_group": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "error": {"type": ["string", "null"]},
    "conflict": {"type": "boolean"},
    "complete_for_source": {"type": "boolean"}
  },
  "additionalProperties": false
}
