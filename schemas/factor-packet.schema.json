{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crypto-portfolio-manager/factor-packet.schema.json",
  "title": "Compact asset factor packet",
  "type": "object",
  "required": ["symbol", "coverage"],
  "properties": {
    "symbol": {"type": "string", "minLength": 1},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "trend_facts": {"$ref": "#/$defs/facts"},
    "valuation_facts": {"$ref": "#/$defs/facts"},
    "btc_valuation_facts": {"$ref": "#/$defs/facts"},
    "macro_liquidity_facts": {"$ref": "#/$defs/facts"},
    "fundamental_facts": {"$ref": "#/$defs/facts"},
    "onchain_facts": {"$ref": "#/$defs/facts"},
    "flow_facts": {"$ref": "#/$defs/facts"},
    "relative_strength_facts": {"$ref": "#/$defs/facts"},
    "event_facts": {"$ref": "#/$defs/facts"},
    "previous_assessment": {"type": "object"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manual_asset_contexts": {"type": "array", "items": {"$ref": "#/$defs/manualAssetContext"}}
  },
  "additionalProperties": false,
  "$defs": {
    "facts": {
      "type": "object",
      "required": ["symbol", "current", "previous", "changes", "trends", "coverage", "freshness", "source_ids", "data_quality_flags"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "current": {"type": "object"},
        "previous": {"type": "object"},
        "changes": {"type": "object"},
        "trends": {"type": "object"},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "freshness": {"enum": ["CURRENT", "STALE", "UNKNOWN"]},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "data_quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "manualAssetContext": {
      "type": "object",
      "required": ["asset", "category", "summary", "impact", "severity", "scope", "as_of", "source"],
      "properties": {
        "asset": {"type": "string", "minLength": 1},
        "category": {"enum": ["GOVERNANCE", "TOKENOMICS", "LEGAL", "PROTOCOL", "OTHER"]},
        "summary": {"type": "string", "minLength": 1},
        "impact": {"enum": ["POSITIVE", "NEGATIVE", "MIXED", "NEUTRAL"]},
        "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "scope": {"enum": ["CONTEXT_ONLY", "FUNDAMENTALS", "RISK", "EXECUTION"]},
        "as_of": {"type": "string", "format": "date-time"},
        "source": {"const": "MANUAL_USER_INPUT"}
      },
      "additionalProperties": false
    }
  }
}
